{
  "name": "mobile-wallet-verifier-certificate-signing-requests",
  "version": "1.0.0",
  "description": "Mobile wallet verifier CSR backend services",
  "type": "module",
  "scripts": {
    "postinstall": "husky || true",
    "build": "mkdir -p dist && cp -f open-api-spec.yaml dist/ && node build.mjs",
    "test": "./node_modules/.bin/vitest run --project infra --project script-unit",
    "test:infra": "./node_modules/.bin/vitest run --project infra",
    "test:system": "./node_modules/.bin/vitest run --project system",
    "typecheck": "./node_modules/.bin/tsc --noEmit",
    "lint": "./node_modules/.bin/eslint .",
    "format": "./node_modules/.bin/prettier --write '**/*.{json,md,ts}'",
    "format:check": "./node_modules/.bin/prettier --check '**/*.{json,md,ts}'",
    "issue-revoke-ca": "tsx scripts/issue-revoke-ca.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-acm-pca": "3.1157.0",
    "@aws-sdk/client-cloudformation": "3.1157.0",
    "@aws-sdk/client-s3": "3.1157.0",
    "@aws-sdk/client-sts": "3.1157.0",
    "@aws-sdk/s3-request-presigner": "3.1157.0",
    "@aws-lambda-powertools/logger": "2.36.0",
    "@aws-sdk/client-sns": "3.1157.0",
    "@peculiar/asn1-csr": "2.11.0",
    "@peculiar/asn1-schema": "2.11.0",
    "@peculiar/asn1-x509": "2.11.0",
    "@peculiar/x509": "2.2.0",
    "@smithy/node-http-handler": "4.13.0",
    "esbuild": "0.28.2",
    "reflect-metadata": "0.2.2"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@aws-sdk/client-sts": "3.1157.0",
    "@cucumber/cucumber": "13.3.0",
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "aws-sdk-client-mock": "4.1.0",
    "aws-sdk-client-mock-vitest": "8.0.0",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "jest-cucumber": "4.5.0",
    "jiti": "2.7.0",
    "js-yaml": "5.5.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
